# Скопіюй у .env і заповни: cp .env.example .env      (.env — у .gitignore і .dockerignore)
# Значення з `$` — в одинарних лапках: без лапок Compose підставить $змінні.

# PostgreSQL. Пароль — без символів @ : / ? # (він стає частиною URL)
POSTGRES_DB=notes_db
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=

# Django. Ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# У ключі бувають $ і # — тому в одинарних лапках: DJANGO_SECRET_KEY='…'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Хто може бути в заголовку Host: твій домен + localhost і 127.0.0.1 (healthcheck зсередини контейнера)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# https-сайт за nginx з TLS: DJANGO_HTTPS=1 і DJANGO_CSRF_TRUSTED_ORIGINS=https://notes.example
DJANGO_HTTPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=

# Порт nginx на сервері
HTTP_PORT=80
