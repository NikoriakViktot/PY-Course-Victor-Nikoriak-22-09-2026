{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(mypy *)",
      "Bash(git diff *)",
      "Bash(git status *)"
    ],
    "ask": [
      "Edit(./tests/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(pip install *)",
      "Bash(git push *)",
      "Bash(alembic downgrade *)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/unit_tests.py\""
          }
        ]
      }
    ]
  }
}
