          }
        }
      ]
    },
    {
      "name": "7. створити новину",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/news",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Гривня зміцнилася до долара на міжбанку\",\n  \"url\": \"https://www.rbc.ua/ukr/news/hryvnia-777.html\",\n  \"published_time\": \"09:05\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const news = pm.response.json();",
              "pm.test(\"є id і scraped_at від бази\", () => { pm.expect(news.id).to.be.a(\"number\"); pm.expect(news.scraped_at).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"newsId\", news.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. та сама новина вдруге",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/news",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
