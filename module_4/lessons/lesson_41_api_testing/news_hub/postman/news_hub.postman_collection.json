    {
      "name": "12a. фоновий збір",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scrape/jobs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scrape",
            "jobs"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"snapshot\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
              "pm.collectionVariables.set(\"jobId\", pm.response.json().job_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12b. статус задачі",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scrape/jobs/{{jobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scrape",
            "jobs",
            "{{jobId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 202 означає «прийнято», а не «готово»: опитуємо статус, поки задача queued/running",
              "const job = pm.response.json();",
              "const tries = Number(pm.collectionVariables.get(\"jobTries\") || 0);",
              "if ([\"queued\", \"running\"].includes(job.status) && tries < 20) {",
              "    pm.collectionVariables.set(\"jobTries\", tries + 1);",
              "    setTimeout(() => {}, 250);                          // пауза перед наступною спробою",
              "    postman.setNextRequest(\"12b. статус задачі\");       // той самий запит ще раз",
              "} else {",
              "    pm.test(\"задача завершилась: done\", () => pm.expect(job.status).to.eql(\"done\"));",
              "    pm.test(\"зі знімка нічого нового (вже в базі)\", () => pm.expect(job.news_saved).to.eql(0));",
              "}"
            ]
          }
        }
      ]
    },
