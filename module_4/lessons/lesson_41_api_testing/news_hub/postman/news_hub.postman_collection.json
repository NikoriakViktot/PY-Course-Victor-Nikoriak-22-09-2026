{
  "info": {
    "name": "news_hub — урок 39",
    "description": "Запити до API агрегатора. Сервер: alembic upgrade head && uvicorn news_hub.api:app --reload (Redis — REDIS_URL), потім Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Сервер живий?"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 і status ok\", () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. зібрати знімок",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scrape",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scrape"
          ]
        },
        "description": "Завантажує data/rbc_news_snapshot.json, перевіряє NewsItem, зберігає нові.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"snapshot\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const report = pm.response.json();",
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"усі 168 новин зі знімка перевірені\", () => pm.expect(report.news_valid).to.eql(168));",
              "pm.collectionVariables.set(\"total\", report.news_total);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. українські новини",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news?lang=uk&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news"
          ],
          "query": [
            {
              "key": "lang",
              "value": "uk"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const news = pm.response.json();",
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"не більше limit\", () => pm.expect(news.length).to.be.at.most(5));",
              "pm.test(\"усі lang = uk\", () => news.forEach(n => pm.expect(n.lang).to.eql(\"uk\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "3a. ще раз — з кешу",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news?lang=uk&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news?lang=uk&limit=5"
          ],
          "query": [
            {
              "key": "lang",
              "value": "uk"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"X-Cache: HIT — відповідь з Redis\", () => pm.expect(pm.response.headers.get(\"X-Cache\")).to.eql(\"HIT\"));",
              "pm.test(\"є X-Request-ID і X-Process-Time\", () => {",
              "    pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.a(\"string\");",
              "    pm.expect(pm.response.headers.get(\"X-Process-Time\")).to.match(/ms$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. статистика",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news",
            "stats"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stats = pm.response.json();",
              "pm.test(\"total = кількості після збору\", () =>",
              "    pm.expect(stats.total).to.eql(Number(pm.collectionVariables.get(\"total\"))));",
              "pm.test(\"є мови uk і ru\", () => pm.expect(stats.lang).to.have.keys(\"uk\", \"ru\"));"
            ]
          }
        }
      ]
    },
