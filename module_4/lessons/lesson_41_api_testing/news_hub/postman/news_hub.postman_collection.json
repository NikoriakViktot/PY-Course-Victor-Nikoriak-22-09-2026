            "{{newsId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"Економіка\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 і нова категорія\", () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().category).to.eql(\"Економіка\");",
              "});"
            ]
          }
        }
      ]
    },
    {
