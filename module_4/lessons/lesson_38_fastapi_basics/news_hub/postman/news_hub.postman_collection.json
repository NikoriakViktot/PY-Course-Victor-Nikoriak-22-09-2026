{
  "info": {
    "name": "news_hub — урок 37",
    "description": "Запити до API агрегатора. Запусти сервер: uvicorn news_hub.api:app --reload, потім Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Сервер живий?"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 і status ok\", () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. зібрати знімок",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scrape",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scrape"
          ]
        },
        "description": "Завантажує data/rbc_news_snapshot.json, перевіряє NewsItem, зберігає нові.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"snapshot\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const report = pm.response.json();",
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"усі 168 новин зі знімка перевірені\", () => pm.expect(report.news_valid).to.eql(168));",
              "pm.collectionVariables.set(\"total\", report.news_total);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. українські новини",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news?lang=uk&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news"
          ],
          "query": [
            {
              "key": "lang",
              "value": "uk"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const news = pm.response.json();",
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"не більше limit\", () => pm.expect(news.length).to.be.at.most(5));",
              "pm.test(\"усі lang = uk\", () => news.forEach(n => pm.expect(n.lang).to.eql(\"uk\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. статистика",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news",
            "stats"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stats = pm.response.json();",
              "pm.test(\"total = кількості після збору\", () =>",
              "    pm.expect(stats.total).to.eql(Number(pm.collectionVariables.get(\"total\"))));",
              "pm.test(\"є мови uk і ru\", () => pm.expect(stats.lang).to.have.keys(\"uk\", \"ru\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. помилка: lang=en",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news?lang=en",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news"
          ],
          "query": [
            {
              "key": "lang",
              "value": "en"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422 — FastAPI перевірив параметр\", () => pm.response.to.have.status(422));",
              "pm.test(\"помилка в полі lang\", () =>",
              "    pm.expect(pm.response.json().detail[0].loc).to.eql([\"query\", \"lang\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. помилка: чужий сайт",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scrape",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scrape"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pages\": [\n    \"https://example.com/\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422 — сервер не завантажує чужі URL\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. очистити",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/news",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "news"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"видалено стільки, скільки було\", () =>",
              "    pm.expect(pm.response.json().deleted).to.eql(Number(pm.collectionVariables.get(\"total\"))));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "total",
      "value": "0"
    }
  ]
}